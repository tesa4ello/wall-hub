[Unit]
Description=Wall-HUB backend
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=wallhub
Group=wallhub
WorkingDirectory=/opt/wallhub/current
Environment=PYTHONUNBUFFERED=1
Environment=WALLHUB_CONFIG=/var/lib/wallhub/config.json
Environment=WALLHUB_WEB=/opt/wallhub/current/web
ExecStart=/opt/wallhub/current/venv/bin/python -m wallhub
Restart=always
RestartSec=2
# Админка слушает порт 80, а root сервису не нужен.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

StateDirectory=wallhub
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
