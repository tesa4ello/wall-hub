[Unit]
Description=Wall-HUB update check (schedule is in the panel settings)

# Таймер только будит обновлятор, а пора ли проверять, он решает сам по
# расписанию из настроек (update.schedule / update.time).
[Timer]
OnCalendar=*:0/15
RandomizedDelaySec=1min
Unit=wallhub-update@auto.service

[Install]
WantedBy=timers.target
