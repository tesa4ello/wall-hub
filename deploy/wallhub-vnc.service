# Трансляция экрана панели в админку (вкладка «Трансляция»).
# Сервис wallhub запускает юнит, пока кто-то смотрит, и гасит после.
# x11vnc слушает только 127.0.0.1: снаружи экран виден лишь через админку
# (после входа), сервис проксирует туда WebSocket.
[Unit]
Description=Wall-HUB: VNC-доступ к экрану панели (только localhost)
After=getty@tty1.service

[Service]
User=kiosk
Environment=DISPLAY=:0
ExecStart=/usr/bin/x11vnc -display :0 -auth guess -localhost -rfbport 5900 -nopw -shared -forever -noxdamage -quiet
Restart=on-failure
RestartSec=3
