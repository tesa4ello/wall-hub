// Сервис wallhub управляет Wi‑Fi, питанием, часовым поясом и временем без root,
// а также запускает проверку и установку обновлений, перенос Ethernet под
// NetworkManager (кнопки в админке)
// и трансляцию экрана в админку.
polkit.addRule(function (action, subject) {
    if (subject.user !== "wallhub") {
        return;
    }
    var id = action.id;
    if (id.indexOf("org.freedesktop.NetworkManager.") === 0 ||
        id.indexOf("org.freedesktop.login1.reboot") === 0 ||
        id.indexOf("org.freedesktop.login1.power-off") === 0 ||
        id === "org.freedesktop.timedate1.set-timezone" ||
        id === "org.freedesktop.timedate1.set-ntp" ||
        id === "org.freedesktop.timedate1.set-time") {
        return polkit.Result.YES;
    }
    if (id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") === "start" &&
        (action.lookup("unit") === "wallhub-update@check.service" ||
         action.lookup("unit") === "wallhub-update@install.service" ||
         action.lookup("unit") === "wallhub-update@rollback.service" ||
         action.lookup("unit") === "wallhub-net-ethernet.service")) {
        return polkit.Result.YES;
    }
    // Свои NTP-серверы: после правки drop-in timesyncd перезапускается.
    if (id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "systemd-timesyncd.service" &&
        action.lookup("verb") === "restart") {
        return polkit.Result.YES;
    }
    if (id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "wallhub-vnc.service" &&
        (action.lookup("verb") === "start" || action.lookup("verb") === "stop")) {
        return polkit.Result.YES;
    }
});
